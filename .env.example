# Copy to .env.local. Do not commit real values.
# Anon and service-role keys stay on the server. Do not prefix them with NEXT_PUBLIC_.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ characters. Used to hash captcha answers, session cookies and IP addresses.
CAPTCHA_PEPPER=

# Public site origin used for canonical links. No trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only on a demo environment. Production must leave this unset.
SHOW_DEMO_RATES=false

# Protects POST /api/cron/expire
CRON_SECRET=

# Used only by npm run create-admin. At least 15 characters. Never commit the real password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
